# ==============================================================================
# COOP HUB — Environment Configuration Template (.env.example)
# Never commit production keys or real government credentials to Git.
# Copy this file to .env and fill in environment-appropriate variables.
# ==============================================================================

# --- Frontend Configurations (Client-safe, exposed to browser via Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_NVIDIA_API_KEY=your-nvidia-api-key
VITE_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
VITE_NVIDIA_OCR_MODEL=nvidia/nemotron-parse
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Backend Core AI Providers (Keep secret on server) ---
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_OCR_MODEL=nvidia/nemotron-parse
GEMINI_API_KEY=your-gemini-api-key

# --- Authoritative Government KYC Gateways (Production & Staging only) ---
# UIDAI Digital Signature Certificate Public Key (PEM or RSA Base64) for QR signature verification
UIDAI_DSC_PUBLIC_KEY=your-uidai-dsc-public-key-pem

# UIDAI Authentication Facility (Only when official AUA/KUA HSM credentials exist)
UIDAI_AUTH_CLIENT_ID=your-uidai-client-id
UIDAI_AUTH_API_KEY=your-uidai-api-key

# DigiLocker MeriPehchaan Partner OAuth2 Integration
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/kyc/digilocker/callback

# Income Tax Department (NSDL / UTIITSL) PAN Verification API
NSDL_PAN_API_KEY=your-nsdl-pan-api-key
UTIITSL_API_KEY=your-utiitsl-api-key

# Ministry of Road Transport & Highways (Parivahan Sarathi) Driving Licence API
PARIVAHAN_SARATHI_API_KEY=your-parivahan-api-key

# Election Commission of India (ECI NVSP) Voter ID API
ECI_NVSP_API_KEY=your-eci-nvsp-api-key

# --- OCR Engine Microservices (PaddleOCR & EasyOCR Workers) ---
PADDLE_OCR_SERVICE_URL=http://localhost:8001/ocr/paddle
EASY_OCR_SERVICE_URL=http://localhost:8002/ocr/easy

# --- Server & Infrastructure Configuration ---
PORT=5000
INSTANCE_ID=api-1
NODE_ENV=development
