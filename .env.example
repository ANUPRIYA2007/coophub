# ===========================
# COOP HUB Environment Config
# ===========================

# --- Frontend Configurations (Safe to expose) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google Maps Platform API Key (Maps JS, Places, Routes, Geocoding)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_NVIDIA_API_KEY=your-nvidia-api-key
VITE_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Backend API Secrets (Never expose to Git/Browser) ---
# Primary AI Provider (NVIDIA Nemotron via OpenAI standard)
NVIDIA_API_KEY=
NVIDIA_MODEL=Llama-3.3-Nemotron-Super-49B-v1.5

# Secondary AI Provider (Gemini Fallback)
GEMINI_API_KEY=

# Email Secrets
MAIL_USER=
MAIL_APP_PASSWORD=
# MAIL_PASSWORD is also supported as legacy fallback
MAIL_PASSWORD=
